{
  "name": "personal-reading-tracker",
  "version": "1.0.0",
  "description": "A personal reading tracker application with progress tracking and highlights management",
  "scripts": {
    "test": "cd backend && npm test",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm start",
    "docker:build": "docker build -t personal-reading-tracker .",
    "docker:run": "docker run -p 3000:3000 personal-reading-tracker"
  }
}
